<mjml>
  <mj-head>
    <mj-style>
      .plain { color: #ff0000; }
      .other { text-decoration: underline; }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text css-class="plain">plain style</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
