<mjml>
  <mj-head>
    <mj-attributes>
      <mj-section background-url="https://example.com/head.png" background-size="contain" background-position="left" />
      <mj-class name="tiled" background-repeat="repeat" background-position="10.5% bottom" background-size="30px 40px" />
    </mj-attributes>
  </mj-head>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text>Defaulted</mj-text>
      </mj-column>
    </mj-section>
    <mj-section mj-class="tiled" background-color="#abcdef">
      <mj-column>
        <mj-text>Classed</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
