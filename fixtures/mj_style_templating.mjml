<mjml>
  <mj-head>
    <mj-style inline="inline">
      .probe { color: #ff00ff; }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-raw>{{#if user}}<span class="probe">handlebars block</span>{{/if}}<span class="probe">{{ "<div class='probe'>" }}</span><b class="probe"><%= "<i class='probe'>" %></b><p class="probe" title="{{#if a}}x > y{{/if}}">attribute value</p></mj-raw>
    <mj-section>
      <mj-column>
        <mj-text css-class="probe">ordinary content still inlines</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
