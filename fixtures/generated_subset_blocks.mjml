<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="0px 0px 0px 0px">
      <mj-column padding="0px 0px 0px 0px">
        <mj-text font-family="Inter, Arial, sans-serif" font-size="16px" font-weight="400" line-height="22px" color="#222222" align="left" padding="8px 16px 8px 16px">Text block</mj-text>
        <mj-text font-size="16px" font-weight="700" line-height="22px" color="#222222" align="right" padding="0px 0px 0px 0px">Text with no font-family, inheriting mj-all</mj-text>
        <mj-image src="images/photo.png" width="320px" alt="A photo" align="left" padding="4px 4px 4px 4px" />
        <mj-image src="images/linked.png" width="120px" alt="" href="https://example.com/" align="center" padding="0px 0px 0px 0px" />
        <mj-button href="#" background-color="#111111" color="#ffffff" font-size="14px" font-weight="400" border-radius="0px" align="left" padding="0px 0px 0px 0px" inner-padding="10px 18px 10px 18px">Square button</mj-button>
        <mj-button href="https://example.com/go" background-color="#e53e3e" color="#ffffff" font-size="18px" font-weight="700" border-radius="24px" align="center" padding="12px 0px 12px 0px" inner-padding="14px 28px 14px 28px">Pill button</mj-button>
        <mj-divider border-color="#e2e2e2" border-width="1px" padding="16px 0px 16px 0px" />
        <mj-divider border-color="#2b6cb0" border-width="4px" padding="0px 24px 0px 24px" />
        <mj-spacer height="32px" />
        <mj-spacer height="4.5px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
