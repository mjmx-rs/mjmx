{
  "name": "@mjmx-rs/node",
  "version": "0.1.1",
  "description": "Node.js bindings for mjmx — an MJML-to-HTML compiler written in Rust.",
  "keywords": [
    "mjml",
    "mjmx",
    "email",
    "html",
    "compiler",
    "napi",
    "rust"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjmx-rs/mjmx.git",
    "directory": "crates/mjmx-napi"
  },
  "homepage": "https://github.com/mjmx-rs/mjmx#readme",
  "bugs": {
    "url": "https://github.com/mjmx-rs/mjmx/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "napi": {
    "binaryName": "mjmx",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "@mjmx-rs/node-linux-x64-gnu": "0.1.1",
    "@mjmx-rs/node-linux-arm64-gnu": "0.1.1",
    "@mjmx-rs/node-darwin-x64": "0.1.1",
    "@mjmx-rs/node-darwin-arm64": "0.1.1",
    "@mjmx-rs/node-win32-x64-msvc": "0.1.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4"
  },
  "scripts": {
    "build": "cargo build -p mjmx-napi --release",
    "napi:create-dirs": "napi create-npm-dirs",
    "napi:version": "napi version",
    "test": "node test/smoke.mjs"
  }
}
