{
  "name": "@mjmx-rs/mjmx",
  "version": "0.1.1",
  "description": "MJML-to-HTML email compiler for JavaScript — written in Rust, compiled to WebAssembly.",
  "keywords": [
    "mjml",
    "mjmx",
    "email",
    "html",
    "compiler",
    "wasm",
    "webassembly",
    "rust"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjmx-rs/mjmx.git",
    "directory": "crates/mjmx-wasm"
  },
  "homepage": "https://github.com/mjmx-rs/mjmx#readme",
  "bugs": {
    "url": "https://github.com/mjmx-rs/mjmx/issues"
  },
  "main": "pkg/node/mjmx_wasm.js",
  "module": "pkg/bundler/mjmx_wasm.js",
  "browser": "pkg/web/mjmx_wasm.js",
  "types": "pkg/bundler/mjmx_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/bundler/mjmx_wasm.d.ts",
      "node": {
        "require": "./pkg/node/mjmx_wasm.js",
        "import": "./pkg/node/mjmx_wasm.js"
      },
      "browser": "./pkg/web/mjmx_wasm.js",
      "import": "./pkg/bundler/mjmx_wasm.js",
      "default": "./pkg/bundler/mjmx_wasm.js"
    },
    "./package.json": "./package.json",
    "./pkg/*": "./pkg/*"
  },
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "pkg/node/",
    "pkg/bundler/",
    "pkg/web/",
    "README.md"
  ],
  "scripts": {
    "build": "make -C ../.. wasm",
    "test": "node test/smoke.mjs"
  }
}
